erDiagram
    %% ============================================================
    %% ADMINISTRATIVE PROCEDURES NAVIGATOR — COMPLETE ERD (ENGLISH)
    %% ============================================================

    %% ─────────────── BLOCK 1: Lookup / Dictionaries ───────────────

    citizenship_groups {
        int id PK "unsigned"
        varchar code UK "varchar(20)"
        varchar name "varchar(80)"
        varchar description "varchar(255)"
    }

    countries {
        smallint id PK "unsigned"
        char iso_code UK "char(3)"
        varchar name UK "varchar(100)"
        int citizenship_group_id FK "unsigned"
    }

    residence_bases {
        smallint id PK "unsigned"
        varchar code UK "varchar(30)"
        varchar name "varchar(100)"
        varchar description "varchar(255)"
    }

    residence_purposes {
        smallint id PK "unsigned"
        varchar code UK "varchar(30)"
        varchar name "varchar(100)"
        varchar description "varchar(255)"
    }

    employment_types {
        tinyint id PK "unsigned"
        varchar code UK "varchar(30)"
        varchar name "varchar(80)"
        varchar description "varchar(255)"
    }

    %% ─────────────── BLOCK 2: Institutions & Procedures ───────────────

    institutions {
        smallint id PK "unsigned"
        varchar code UK "varchar(30)"
        varchar name "varchar(150)"
        varchar type "varchar(50)"
        varchar website_url "varchar(255)"
        text description
    }

    institution_branches {
        int id PK "unsigned"
        smallint institution_id FK "unsigned"
        varchar city "varchar(80)"
        varchar address "varchar(150)"
        varchar postal_code "varchar(10)"
        varchar phone "varchar(30)"
        varchar email "varchar(100)"
        varchar opening_hours "varchar(255)"
    }

    procedures {
        int id PK "unsigned"
        smallint institution_id FK "unsigned"
        varchar code UK "varchar(50)"
        varchar name "varchar(200)"
        text description
        smallint processing_days "unsigned"
        decimal cost_pln "decimal(8,2)"
        varchar submission_mode "varchar(100)"
        varchar source_url "varchar(255)"
        date verification_date
        varchar verified_by "varchar(100)"
        smallint review_interval_days "unsigned"
        varchar status "varchar(20)"
        datetime created_at
        datetime updated_at
    }

    procedure_steps {
        int id PK "unsigned"
        int procedure_id FK "unsigned"
        tinyint step_number "unsigned"
        varchar name "varchar(150)"
        text description
        boolean is_optional
    }

    procedure_dependencies {
        int id PK "unsigned"
        int procedure_id FK "unsigned"
        int required_procedure_id FK "unsigned"
        varchar dependency_type "varchar(10) AND/OR"
        varchar description "varchar(255)"
    }

    availability_rules {
        int id PK "unsigned"
        int procedure_id FK "unsigned"
        int citizenship_group_id FK "unsigned"
        smallint residence_basis_id FK "unsigned"
        smallint residence_purpose_id FK "unsigned"
        boolean is_available
        varchar special_condition "varchar(255)"
    }

    %% ─────────────── BLOCK 3: Documents Hierarchy ───────────────

    document_categories {
        tinyint id PK "unsigned"
        varchar code UK "varchar(20)"
        varchar name "varchar(80)"
        tinyint status "1=active, 0=retired"
    }

    document_subcategories {
        smallint id PK "unsigned"
        tinyint category_id FK "unsigned"
        varchar code UK "varchar(20)"
        varchar name "varchar(100)"
        tinyint status "1=active, 0=retired"
    }

    documents {
        int id PK "unsigned"
        smallint subcategory_id FK "unsigned"
        varchar code UK "varchar(30)"
        varchar name "varchar(150)"
        boolean has_expiry_date
        boolean requires_sworn_translation
        text description
    }

    procedure_documents {
        int id PK "unsigned"
        int procedure_id FK "unsigned"
        int document_id FK "unsigned"
        boolean is_required
        varchar alternative_group "varchar(20)"
        varchar description "varchar(255)"
    }

    document_issuing_places {
        int id PK "unsigned"
        int document_id FK "unsigned"
        smallint institution_id FK "unsigned"
        varchar description "varchar(255)"
        varchar portal_url "varchar(255)"
    }

    %% ─────────────── BLOCK 4: Life Situations ───────────────

    life_situations {
        smallint id PK "unsigned"
        varchar code UK "varchar(50)"
        varchar name "varchar(150)"
        text description
    }

    situation_procedures {
        int id PK "unsigned"
        smallint situation_id FK "unsigned"
        int procedure_id FK "unsigned"
        smallint default_order "unsigned"
        boolean is_mandatory
    }

    %% ─────────────── BLOCK 5: Multilingual Content & Glossary ───────────────

    languages {
        tinyint id PK "unsigned"
        char code UK "char(2)"
        varchar name "varchar(50)"
        boolean is_active
        boolean is_default
    }

    translations {
        int id PK "unsigned"
        tinyint language_id FK "unsigned"
        varchar table_name "varchar(50)"
        varchar column_name "varchar(50)"
        int record_id "unsigned"
        text content
    }

    glossary_terms {
        int id PK "unsigned"
        varchar term_pl UK "varchar(100)"
        text definition_pl
        varchar category "varchar(50)"
    }

    %% ─────────────── BLOCK 6: Data Freshness & Audit ───────────────

    official_sources {
        smallint id PK "unsigned"
        varchar name "varchar(120)"
        varchar url UK "varchar(255)"
        varchar type "varchar(50)"
        varchar description "varchar(255)"
        datetime last_checked_at
    }

    change_log {
        bigint id PK "unsigned"
        int user_id FK "unsigned"
        varchar table_name "varchar(50)"
        int record_id "unsigned"
        column_name varchar "varchar(50)"
        text old_value
        text new_value
        datetime changed_at
    }

    %% ─────────────── BLOCK 7: Users & RBAC ───────────────

    roles {
        tinyint id PK "unsigned"
        varchar code UK "varchar(30)"
        varchar name "varchar(60)"
        varchar description "varchar(255)"
    }

    permissions {
        smallint id PK "unsigned"
        varchar code UK "varchar(50)"
        varchar name "varchar(100)"
        varchar description "varchar(255)"
    }

    role_permissions {
        tinyint role_id PK,FK "unsigned"
        smallint permission_id PK,FK "unsigned"
    }

    users {
        int id PK "unsigned"
        varchar email UK "varchar(120)"
        varchar password_hash "varchar(255)"
        tinyint language_id FK "unsigned"
        boolean gdpr_consent
        boolean is_active
        datetime created_at
        datetime last_login_at
    }

    user_roles {
        int user_id PK,FK "unsigned"
        tinyint role_id PK,FK "unsigned"
    }

    user_profiles {
        int id PK "unsigned"
        int user_id UK,FK "unsigned"
        smallint country_id FK "unsigned"
        smallint residence_basis_id FK "unsigned"
        smallint residence_purpose_id FK "unsigned"
        tinyint employment_type_id FK "unsigned"
        date arrival_date
    }

    %% ─────────────── BLOCK 8: Progress, Helpers & Reminders ───────────────

    user_progress {
        int id PK "unsigned"
        int user_id FK "unsigned"
        int procedure_id FK "unsigned"
        int step_id FK "unsigned"
        varchar status "varchar(20)"
        datetime completed_at
        varchar completed_by "client/helper"
        text note
    }

    user_documents {
        int id PK "unsigned"
        int user_id FK "unsigned"
        int document_id FK "unsigned"
        boolean is_possessed
        date expiry_date
        datetime added_at
    }

    helpers {
        int id PK "unsigned"
        int helper_id FK "unsigned"
        int client_id FK "unsigned"
        varchar invitation_code UK "varchar(36)"
        varchar status "varchar(20)"
        datetime invited_at
        datetime accepted_at
    }

    helper_notes {
        int id PK "unsigned"
        int assignment_id FK "unsigned"
        int step_id FK "unsigned"
        text content
        datetime created_at
    }

    reminders {
        int id PK "unsigned"
        int user_id FK "unsigned"
        int procedure_id FK "unsigned"
        date reminder_date
        varchar content "varchar(255)"
        boolean is_sent
    }

