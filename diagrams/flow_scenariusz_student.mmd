%% Activity/Flow Diagram: Scenariusz - Student spoza UE
%% Nawigator procedur administracyjnych

flowchart TD
    START(["▶ Scenariusz: Student spoza UE"])

    START --> A["📄 1. Przyjęcie na uczelnię\n(decyzja o przyjęciu /\nzaświadczenie o statusie studenta)"]

    A --> B["🛂 2. Zezwolenie na pobyt\ncel: NAUKA\n(wiza studencka lub\nkarta pobytu czasowego)"]

    B --> C["🏠 3. Zameldowanie\n(rejestracja adresu\nw urzędzie gminy)"]
    B --> D["🏥 5. Ubezpieczenie zdrowotne\n(NFZ przez uczelnię\nlub prywatne)"]

    C --> E["🆔 4. PESEL\n(nadanie numeru PESEL\nw urzędzie gminy\nprzy zameldowaniu\nlub osobny wniosek)"]

    D --> F{"Praca w trakcie\nstudiów?"}

    E --> G["Kontynuacja planu..."]
    F -- "Tak" --> H["📋 6. Oświadczenie pracodawcy\no powierzeniu pracy\n(rejestracja w PUP)\nlub zezwolenie na pracę"]
    F -- "Nie" --> G

    H --> G

    G --> ENDX(["⏹ Plan studenta ukończony"])

    %% Annotations for parallel/sequential
    subgraph sequential1 ["🔗 Sekwencyjne: wymagana kolejność"]
        A
        B
    end

    subgraph parallel1 ["⚡ Równoległe: po uzyskaniu zezwolenia na pobyt"]
        C
        D
    end

    subgraph sequential2 ["🔗 Sekwencyjne: PESEL wymaga zameldowania"]
        E
    end

    style START fill:#4CAF50,color:#fff
    style ENDX fill:#9E9E9E,color:#fff
    style A fill:#1976D2,color:#fff
    style B fill:#1976D2,color:#fff
    style C fill:#0097A7,color:#fff
    style D fill:#0097A7,color:#fff
    style E fill:#7B1FA2,color:#fff
    style F fill:#FF8F00,color:#000
    style H fill:#E64A19,color:#fff
    style G fill:#43A047,color:#fff

    style sequential1 fill:#E3F2FD,stroke:#1976D2,stroke-width:2px
    style parallel1 fill:#E0F7FA,stroke:#0097A7,stroke-width:2px
    style sequential2 fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px
