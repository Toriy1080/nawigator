flowchart TD
    classDef startEnd fill:#1e293b,stroke:#0f172a,stroke-width:2px,color:#fff;
    classDef mainStep fill:#2563eb,stroke:#1d4ed8,stroke-width:2px,color:#fff;
    classDef parallelTrack fill:#0891b2,stroke:#0e7490,stroke-width:2px,color:#fff;
    classDef decision fill:#d97706,stroke:#b45309,stroke-width:2px,color:#fff;
    classDef simplified fill:#059669,stroke:#047857,stroke-width:2px,color:#fff;

    Start([Przyjazd obywatela UE do Polski]):::startEnd --> CheckTime{"Pobyt powyżej 3 miesięcy?"}:::decision

    subgraph Faza1 ["Faza 1: Legalizacja pobytu i tożsamość w Polsce"]
        CheckTime -- Tak --> RegPobyt["Rejestracja pobytu obywatela UE<br/>(Urząd Wojewódzki / Wydział Spraw Cudzoziemców)<br/>- zaświadczenie o zarejestrowaniu pobytu"]:::simplified
        CheckTime -- Nie --> PominReg["Możliwe rozpoczęcie procedur przed upływem 3 mies."]:::simplified
        RegPobyt --> Meladunek["Zameldowanie na pobyt czasowy/stały<br/>(Urząd Dzielnicy / Gminy)"]:::mainStep
        PominReg --> Meladunek
        Meladunek --> PESEL["Uzyskanie numeru PESEL<br/>(automatycznie przy meldunku lub na wniosek)"]:::mainStep
        PESEL --> ProfilZaufany["Założenie Profilu Zaufanego / ePUAP"]:::mainStep
    end

    subgraph Faza2 ["Faza 2: Rejestracja działalności gospodarczej"]
        ProfilZaufany --> CEIDG["Złożenie wniosku CEIDG-1 online (biznes.gov.pl)<br/>- wybór kodów PKD<br/>- wybór formy opodatkowania (skala, liniowy, ryczałt)<br/>- automatyczne nadanie NIP i REGON"]:::simplified
    end

    CEIDG --> ForkJDG{Równoległe procedury po CEIDG}:::decision

    subgraph Faza3_ZUS ["Ścieżka ZUS Przedsiębiorcy"]
        ForkJDG --> ZUS["Zgłoszenie do ZUS (formularz ZUA / ZZA)<br/>- wybór ulgi (Ulga na start / Mały ZUS / ZUS standardowy)<br/>- termin: 7 dni od startu"]:::parallelTrack
    end

    subgraph Faza3_Skarbowy ["Ścieżka Podatkowa i Bankowa"]
        ForkJDG --> CheckVAT{"Czy wymagana / opłacalna rejestracja VAT?"}:::decision
        CheckVAT -- Tak --> VAT["Złożenie formularza VAT-R<br/>(Urząd Skarbowy - przed pierwszą sprzedażą)"]:::parallelTrack
        CheckVAT -- Nie --> ZwolnionyVAT["Zwolnienie podmiotowe z VAT<br/>(do limitu obrotów)"]:::parallelTrack
        
        ForkJDG --> Konto["Założenie rachunku firmowego w banku<br/>+ zgłoszenie rachunku do białej listy VAT"]:::parallelTrack
    end

    ZUS --> Join([JDG w pełni uruchomiona i zgodna z przepisami]):::startEnd
    VAT --> Join
    ZwolnionyVAT --> Join
    Konto --> Join

    class Faza1,Faza2,Faza3_ZUS,Faza3_Skarbowy fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px;
