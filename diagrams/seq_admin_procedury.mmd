sequenceDiagram
    title Zarządzanie procedurami i zależnościami przez administratora

    actor A as Administrator
    participant FE as Frontend
    participant BE as Backend
    participant BD as Baza Danych

    %% ── DODAWANIE NOWEJ PROCEDURY ────────────────────────────
    rect rgb(220, 240, 255)
        Note over A, BD: Administrator dodaje nową procedurę

        A->>FE: Wypełnia formularz nowej procedury<br/>(nazwa, opis, kategoria, instytucja,<br/>czas_realizacji, wymagane_dokumenty)
        FE->>BE: POST /api/admin/procedury<br/>{nazwa, opis, kategoria, instytucja_id,<br/>czas_realizacji, wymagane_dokumenty,<br/>status: 'do_sprawdzenia'}

        BE->>BE: Walidacja danych<br/>(wymagane pola, poprawność typów)

        BE->>BD: INSERT INTO procedury<br/>(nazwa, opis, kategoria, instytucja_id,<br/>czas_realizacji, status,<br/>utworzono_przez, data_utworzenia)
        BD-->>BE: procedura_id

        BE->>BD: INSERT INTO dziennik_zmian<br/>(tabela: 'procedury', rekord_id,<br/>operacja: 'utworzenie',<br/>uzytkownik_id: admin_id,<br/>nowa_wartosc: '{cały rekord w JSON}')
        BD-->>BE: OK

        BE-->>FE: 201 Created<br/>{procedura_id, nazwa, status}
        FE-->>A: Potwierdzenie dodania procedury
    end

    %% ── DODAWANIE ZALEŻNOŚCI MIĘDZY PROCEDURAMI ──────────────
    rect rgb(230, 255, 230)
        Note over A, BD: Administrator dodaje zależność

        A->>FE: Definiuje zależność:<br/>"Procedura B wymaga Procedury A"
        FE->>BE: POST /api/admin/zaleznosci<br/>{procedura_id: B, wymaga_id: A,<br/>typ: 'wymagana'}

        Note over BE: Detekcja cykli PRZED zapisem

        BE->>BD: WITH RECURSIVE sciezka AS (<br/>  SELECT wymaga_id, procedura_id,<br/>  ARRAY[procedura_id] AS odwiedzone<br/>  FROM zaleznosci<br/>  WHERE procedura_id = A<br/>  UNION ALL<br/>  SELECT z.wymaga_id, z.procedura_id,<br/>  s.odwiedzone || z.procedura_id<br/>  FROM zaleznosci z<br/>  JOIN sciezka s ON z.procedura_id = s.wymaga_id<br/>  WHERE NOT z.procedura_id = ANY(s.odwiedzone)<br/>)<br/>SELECT * FROM sciezka<br/>WHERE wymaga_id = B
        BD-->>BE: Wynik detekcji cykli

        alt Wykryto cykl w grafie zależności
            BE-->>FE: 409 Conflict<br/>{error: "Dodanie tej zależności<br/>spowodowałoby cykl",<br/>cykl: "A → X → Y → B → A"}
            FE-->>A: Komunikat o błędzie:<br/>"Nie można dodać zależności —<br/>wykryto cykl: A → X → Y → B → A"
        else Brak cyklu — zapis dozwolony
            BE->>BD: INSERT INTO zaleznosci<br/>(procedura_id, wymaga_id,<br/>typ, utworzono_przez)
            BD-->>BE: zaleznosc_id

            BE->>BD: INSERT INTO dziennik_zmian<br/>(tabela: 'zaleznosci', rekord_id,<br/>operacja: 'dodanie_zaleznosci',<br/>uzytkownik_id: admin_id,<br/>nowa_wartosc: 'B wymaga A')
            BD-->>BE: OK

            BE-->>FE: 201 Created<br/>{zaleznosc_id, procedura_id, wymaga_id}
            FE-->>A: Potwierdzenie:<br/>"Zależność dodana pomyślnie"
        end
    end

    %% ── DODAWANIE TŁUMACZENIA PROCEDURY ──────────────────────
    rect rgb(245, 235, 255)
        Note over A, BD: Administrator dodaje tłumaczenie

        A->>FE: Dodaje tłumaczenie procedury<br/>(język, przetłumaczona nazwa, opis)
        FE->>BE: POST /api/admin/tlumaczenia<br/>{tabela: 'procedury', kolumna: 'nazwa',<br/>rekord_id, jezyk: 'EN',<br/>wartosc: 'Residence permit application'}

        BE->>BD: INSERT INTO tlumaczenia<br/>(tabela, kolumna, rekord_id,<br/>jezyk, wartosc, utworzono_przez)<br/>ON CONFLICT (tabela, kolumna, rekord_id, jezyk)<br/>DO UPDATE SET wartosc = ?,<br/>data_aktualizacji = NOW()
        BD-->>BE: tlumaczenie_id

        BE->>BD: INSERT INTO dziennik_zmian<br/>(tabela: 'tlumaczenia', rekord_id,<br/>operacja: 'dodanie_tlumaczenia',<br/>uzytkownik_id: admin_id,<br/>nowa_wartosc: '{jezyk: EN, wartosc: ...}')
        BD-->>BE: OK

        BE-->>FE: 201 Created / 200 OK<br/>{tlumaczenie_id, jezyk, wartosc}
        FE-->>A: Potwierdzenie dodania tłumaczenia
    end

    %% ── USTAWIANIE STATUSU WERYFIKACJI ───────────────────────
    rect rgb(255, 245, 220)
        Note over A, BD: Administrator ustawia status weryfikacji

        A->>FE: Zmienia status procedury<br/>(np. 'do_sprawdzenia' → 'zweryfikowana')
        FE->>BE: PUT /api/admin/procedury/{id}/status<br/>{status: 'zweryfikowana'}

        BE->>BD: SELECT status FROM procedury<br/>WHERE id = ?
        BD-->>BE: Aktualny status (np. 'do_sprawdzenia')

        BE->>BD: UPDATE procedury SET<br/>status = 'zweryfikowana',<br/>zweryfikowano_przez = ?,<br/>data_weryfikacji = NOW()<br/>WHERE id = ?
        BD-->>BE: OK

        BE->>BD: INSERT INTO dziennik_zmian<br/>(tabela: 'procedury', rekord_id,<br/>operacja: 'zmiana_statusu',<br/>uzytkownik_id: admin_id,<br/>stara_wartosc: 'do_sprawdzenia',<br/>nowa_wartosc: 'zweryfikowana')
        BD-->>BE: OK

        BE-->>FE: 200 OK<br/>{procedura_id, status: 'zweryfikowana',<br/>data_weryfikacji}
        FE-->>A: Status zaktualizowany ✓
    end

    %% ── PRZEGLĄDANIE LISTY "DO SPRAWDZENIA" ─────────────────
    rect rgb(255, 240, 245)
        Note over A, BD: Administrator przegląda listę do sprawdzenia

        A->>FE: Otwiera panel "Do sprawdzenia"
        FE->>BE: GET /api/admin/procedury?status=do_sprawdzenia<br/>&sort=data_utworzenia&order=asc

        BE->>BD: SELECT p.id, p.nazwa, p.opis,<br/>p.kategoria, p.data_utworzenia,<br/>u.email AS utworzono_przez<br/>FROM procedury p<br/>JOIN uzytkownicy u ON u.id = p.utworzono_przez<br/>WHERE p.status = 'do_sprawdzenia'<br/>ORDER BY p.data_utworzenia ASC
        BD-->>BE: Lista procedur do sprawdzenia

        BE-->>FE: 200 OK<br/>{procedury: [{id, nazwa, opis,<br/>kategoria, data_utworzenia, autor}],<br/>total: 15}
        FE-->>A: Wyświetlenie listy procedur<br/>oczekujących na weryfikację
    end

    %% ── WERYFIKACJA POJEDYNCZEJ PROCEDURY ────────────────────
    rect rgb(240, 255, 240)
        Note over A, BD: Administrator weryfikuje procedurę

        A->>FE: Przegląda szczegóły procedury<br/>i klika "Zweryfikowano"
        FE->>BE: PUT /api/admin/procedury/{id}/weryfikuj

        BE->>BD: BEGIN TRANSACTION

        BE->>BD: UPDATE procedury SET<br/>status = 'zweryfikowana',<br/>zweryfikowano_przez = ?,<br/>data_weryfikacji = NOW()<br/>WHERE id = ?<br/>AND status = 'do_sprawdzenia'
        BD-->>BE: 1 row updated

        BE->>BD: INSERT INTO dziennik_zmian<br/>(tabela: 'procedury', rekord_id,<br/>operacja: 'weryfikacja',<br/>uzytkownik_id: admin_id,<br/>stara_wartosc: 'do_sprawdzenia',<br/>nowa_wartosc: 'zweryfikowana',<br/>szczegoly: 'Procedura zweryfikowana')
        BD-->>BE: OK

        BE->>BD: COMMIT

        BE-->>FE: 200 OK<br/>{procedura_id, status: 'zweryfikowana',<br/>data_weryfikacji, zweryfikowano_przez}
        FE-->>A: Procedura oznaczona jako zweryfikowana ✓<br/>Usunięta z listy "do sprawdzenia"
    end
