%% ============================================================
%% Nawigator procedur administracyjnych — Use Case Diagram
%% Actors: Gość, Klient, Pomocnik, Redaktor, Administrator
%% Grouped by functional areas A–G from specification
%% ============================================================

graph LR

    %% ── Actors ──────────────────────────────────────────────
    Guest(("👤 Gość<br/>(niezarejestrowany)"))
    Client(("👤 Klient<br/>(zarejestrowany)"))
    Helper(("👤 Pomocnik"))
    Editor(("👤 Redaktor<br/>treści"))
    Admin(("👤 Administrator"))

    %% ── Inheritance ─────────────────────────────────────────
    Guest -..->|"«extends»"| Client
    Editor -..->|"«extends»"| Admin

    %% ════════════════════════════════════════════════════════
    %% A — Przeglądanie i wyszukiwanie (publiczne)
    %% ════════════════════════════════════════════════════════
    subgraph A["A · Przeglądanie i wyszukiwanie"]
        A1["Przeglądanie procedur<br/>i opisów"]
        A2["Sprawdzanie wymaganych<br/>dokumentów"]
        A3["Korzystanie<br/>z wyszukiwarki"]
        A4["Korzystanie<br/>ze słownika"]
        A5["Zmiana języka<br/>interfejsu"]
        A6["Wypełnienie ankiety<br/>i podgląd przykładowego planu"]
    end

    Guest --- A1
    Guest --- A2
    Guest --- A3
    Guest --- A4
    Guest --- A5
    Guest --- A6

    %% ════════════════════════════════════════════════════════
    %% B — Rejestracja, logowanie, profil
    %% ════════════════════════════════════════════════════════
    subgraph B["B · Rejestracja / Profil / Konto"]
        B1["Rejestracja /<br/>Logowanie"]
        B2["F-02: Uzupełnianie profilu<br/>(narodowość obowiązkowa)"]
        B3["F-03: Zmiana profilu<br/>(przeliczenie planu)"]
        B4["F-04: Usunięcie konta"]
    end

    Guest --- B1
    Client --- B2
    Client --- B3
    Client --- B4

    %% ════════════════════════════════════════════════════════
    %% C — Plan i sytuacje życiowe
    %% ════════════════════════════════════════════════════════
    subgraph C["C · Plan i sytuacje życiowe"]
        C1["F-05: Wybór<br/>sytuacji życiowej"]
        C2["F-06: Generowanie<br/>planu"]
    end

    Client --- C1
    Client --- C2

    %% ════════════════════════════════════════════════════════
    %% D — Dokumenty i postęp
    %% ════════════════════════════════════════════════════════
    subgraph D["D · Dokumenty i postęp"]
        D1["F-11: Oznaczanie<br/>posiadanych dokumentów"]
        D2["F-12: Śledzenie postępu<br/>(odznaczanie kroków)"]
    end

    Client --- D1
    Client --- D2

    %% ════════════════════════════════════════════════════════
    %% E — Pomocnik i współpraca
    %% ════════════════════════════════════════════════════════
    subgraph E["E · Pomocnik i współpraca"]
        E1["F-16: Zaproszenie /<br/>cofnięcie pomocnika"]
        E2["F-17: Lista podopiecznych<br/>z postępem"]
        E3["Widok planu i postępu<br/>klienta (za zgodą)"]
        E4["F-18: Notatki<br/>do kroków"]
        E5["Oznaczenie kroku<br/>wykonanego wspólnie"]
    end

    Client --- E1
    Helper --- E2
    Helper --- E3
    Helper --- E4
    Helper --- E5

    %% ════════════════════════════════════════════════════════
    %% F — Redakcja treści
    %% ════════════════════════════════════════════════════════
    subgraph F["F · Redakcja treści"]
        F1["Edycja procedur,<br/>dokumentów, tłumaczeń"]
        F2["Oznaczanie procedur<br/>jako zweryfikowane"]
        F3["Edycja źródeł"]
    end

    Editor --- F1
    Editor --- F2
    Editor --- F3

    %% ════════════════════════════════════════════════════════
    %% G — Administracja systemu
    %% ════════════════════════════════════════════════════════
    subgraph G["G · Administracja systemu"]
        G1["F-22: Zarządzanie<br/>kontami i rolami"]
        G2["F-23: Przeglądanie<br/>dziennika zmian"]
        G3["F-20: Zarządzanie<br/>zależnościami i regułami"]
        G4["Konfiguracja<br/>słowników"]
        G5["F-25: Lista<br/>'do sprawdzenia'"]
    end

    Admin --- G1
    Admin --- G2
    Admin --- G3
    Admin --- G4
    Admin --- G5

    %% ── Styles ──────────────────────────────────────────────
    classDef actor fill:#4A90D9,stroke:#2C5F8A,color:#fff,font-weight:bold
    classDef guestUC fill:#E8F5E9,stroke:#43A047,color:#1B5E20
    classDef clientUC fill:#E3F2FD,stroke:#1E88E5,color:#0D47A1
    classDef helperUC fill:#FFF3E0,stroke:#FB8C00,color:#E65100
    classDef editorUC fill:#F3E5F5,stroke:#8E24AA,color:#4A148C
    classDef adminUC fill:#FCE4EC,stroke:#E53935,color:#B71C1C
    classDef areaLabel fill:#F5F5F5,stroke:#9E9E9E,color:#424242,font-weight:bold

    class Guest,Client,Helper,Editor,Admin actor
    class A1,A2,A3,A4,A5,A6 guestUC
    class B1,B2,B3,B4 clientUC
    class C1,C2 clientUC
    class D1,D2 clientUC
    class E1 clientUC
    class E2,E3,E4,E5 helperUC
    class F1,F2,F3 editorUC
    class G1,G2,G3,G4,G5 adminUC
