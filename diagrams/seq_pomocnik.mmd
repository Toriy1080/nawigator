sequenceDiagram
    title Zapraszanie pomocnika i współpraca

    actor K as Klient
    actor P as Pomocnik
    participant FE as Frontend
    participant BE as Backend
    participant BD as Baza Danych

    %% ── WYSYŁANIE ZAPROSZENIA ────────────────────────────────
    rect rgb(220, 240, 255)
        Note over K, BD: Klient zaprasza pomocnika

        K->>FE: Kliknięcie "Zaproś pomocnika"<br/>(podaje email lub generuje kod)
        FE->>BE: POST /api/pomocnicy/zaproszenie<br/>{klient_id, email_pomocnika}<br/>lub {klient_id, typ: 'kod'}

        BE->>BE: Generowanie kodu zaproszenia<br/>(unikalny, ograniczony czasowo)

        BE->>BD: INSERT INTO pomocnicy<br/>(klient_id, email_pomocnika,<br/>kod_zaproszenia, status: 'zaproszony',<br/>data_zaproszenia, wazne_do)
        BD-->>BE: pomocnik_id

        BE->>BD: INSERT INTO dziennik_zmian<br/>(tabela: 'pomocnicy', rekord_id,<br/>operacja: 'zaproszenie',<br/>uzytkownik_id: klient_id)
        BD-->>BE: OK

        alt Zaproszenie emailem
            BE->>BE: Wysłanie emaila z kodem/linkiem<br/>do pomocnika
        end

        BE-->>FE: 201 Created<br/>{pomocnik_id, kod_zaproszenia, status}
        FE-->>K: Wyświetlenie kodu zaproszenia<br/>lub potwierdzenie wysłania emaila
    end

    %% ── AKCEPTACJA ZAPROSZENIA ───────────────────────────────
    rect rgb(230, 255, 230)
        Note over P, BD: Pomocnik akceptuje zaproszenie

        P->>FE: Wprowadza kod zaproszenia<br/>lub klika link z emaila
        FE->>BE: POST /api/pomocnicy/akceptuj<br/>{kod_zaproszenia, pomocnik_uzytkownik_id}

        BE->>BD: SELECT * FROM pomocnicy<br/>WHERE kod_zaproszenia = ?<br/>AND status = 'zaproszony'<br/>AND wazne_do > NOW()
        BD-->>BE: Rekord zaproszenia

        alt Zaproszenie nieważne lub wygasłe
            BE-->>FE: 404 Not Found<br/>"Zaproszenie nie istnieje lub wygasło"
            FE-->>P: Komunikat o błędzie
        else Zaproszenie ważne
            BE->>BD: UPDATE pomocnicy SET<br/>status = 'aktywny',<br/>pomocnik_uzytkownik_id = ?,<br/>data_akceptacji = NOW()<br/>WHERE id = ?
            BD-->>BE: OK

            BE->>BD: INSERT INTO dziennik_zmian<br/>(tabela: 'pomocnicy', rekord_id,<br/>operacja: 'akceptacja',<br/>uzytkownik_id: pomocnik_uzytkownik_id)
            BD-->>BE: OK

            BE-->>FE: 200 OK<br/>{klient_id, status: 'aktywny'}
            FE-->>P: Potwierdzenie:<br/>"Zostałeś pomocnikiem dla [klient]"
        end
    end

    %% ── PRZEGLĄDANIE PLANU KLIENTA ───────────────────────────
    rect rgb(245, 235, 255)
        Note over P, BD: Pomocnik przegląda plan i postęp klienta

        P->>FE: Otwiera panel klienta
        FE->>BE: GET /api/pomocnicy/{klient_id}/plan<br/>Authorization: pomocnik_token

        BE->>BD: SELECT * FROM pomocnicy<br/>WHERE pomocnik_uzytkownik_id = ?<br/>AND klient_id = ?<br/>AND status = 'aktywny'
        BD-->>BE: Potwierdzenie aktywnego dostępu

        BE->>BD: SELECT kp.*, p.nazwa, p.opis<br/>FROM kroki_planu kp<br/>JOIN procedury p ON p.id = kp.procedura_id<br/>WHERE kp.uzytkownik_id = ?<br/>ORDER BY kp.kolejnosc
        BD-->>BE: Plan klienta z postępem

        BE-->>FE: 200 OK<br/>{plan: {kroki: [...], postep: 60%}}
        FE-->>P: Wyświetlenie planu klienta<br/>(tryb tylko do odczytu + notatki)
    end

    %% ── DODAWANIE NOTATKI DO KROKU ───────────────────────────
    rect rgb(255, 245, 220)
        Note over P, BD: Pomocnik dodaje notatkę do kroku

        P->>FE: Pisze notatkę przy kroku<br/>(np. "Pamiętaj zabrać paszport")
        FE->>BE: POST /api/pomocnicy/{klient_id}/kroki/{krok_id}/notatki<br/>{tresc, pomocnik_id}

        BE->>BD: SELECT status FROM pomocnicy<br/>WHERE id = ? AND status = 'aktywny'
        BD-->>BE: Status aktywny ✓

        BE->>BD: INSERT INTO notatki<br/>(krok_id, autor_id, autor_rola: 'pomocnik',<br/>tresc, data_utworzenia)
        BD-->>BE: notatka_id

        BE->>BD: INSERT INTO dziennik_zmian<br/>(tabela: 'notatki', rekord_id: notatka_id,<br/>operacja: 'dodanie_notatki',<br/>uzytkownik_id: pomocnik_id,<br/>szczegoly: 'Notatka do kroku X')
        BD-->>BE: OK

        BE-->>FE: 201 Created<br/>{notatka_id, tresc, data}
        FE-->>P: Notatka dodana ✓
        FE-->>K: Powiadomienie:<br/>"Pomocnik dodał notatkę do kroku X"
    end

    %% ── OZNACZANIE KROKU JAKO WYKONANEGO WSPÓLNIE ────────────
    rect rgb(240, 255, 240)
        Note over P, BD: Pomocnik oznacza krok jako wykonany wspólnie

        P->>FE: Kliknięcie "Oznacz jako wykonane"<br/>przy kroku
        FE->>BE: PUT /api/pomocnicy/{klient_id}/kroki/{krok_id}/status<br/>{status: 'ukonczone', pomocnik_id}

        BE->>BD: SELECT status FROM pomocnicy<br/>WHERE id = ? AND status = 'aktywny'
        BD-->>BE: Status aktywny ✓

        BE->>BD: UPDATE kroki_planu SET<br/>status = 'ukonczone',<br/>data_ukonczenia = NOW(),<br/>wykonane_przez = 'pomocnik',<br/>pomocnik_id = ?<br/>WHERE id = ?
        BD-->>BE: OK

        BE->>BD: INSERT INTO dziennik_zmian<br/>(tabela: 'kroki_planu', rekord_id,<br/>operacja: 'oznaczenie_wykonane',<br/>uzytkownik_id: pomocnik_id,<br/>stara_wartosc: 'w_trakcie',<br/>nowa_wartosc: 'ukonczone')
        BD-->>BE: OK

        BE->>BE: Przelicz dostępność<br/>kolejnych kroków<br/>(odblokuj zależne)

        BE-->>FE: 200 OK<br/>{krok_id, status: 'ukonczone'}
        FE-->>P: Krok oznaczony jako wykonany ✓
        FE-->>K: Powiadomienie:<br/>"Krok X został oznaczony jako wykonany"
    end

    %% ── COFNIĘCIE DOSTĘPU ────────────────────────────────────
    rect rgb(255, 230, 230)
        Note over K, BD: Klient cofa dostęp pomocnikowi

        K->>FE: Kliknięcie "Cofnij dostęp"<br/>przy pomocniku
        FE->>BE: PUT /api/pomocnicy/{pomocnik_id}/cofnij<br/>{klient_id}

        BE->>BD: UPDATE pomocnicy SET<br/>status = 'cofniety',<br/>data_cofniecia = NOW()<br/>WHERE id = ?<br/>AND klient_id = ?
        BD-->>BE: OK

        BE->>BD: INSERT INTO dziennik_zmian<br/>(tabela: 'pomocnicy', rekord_id,<br/>operacja: 'cofniecie_dostepu',<br/>uzytkownik_id: klient_id,<br/>stara_wartosc: 'aktywny',<br/>nowa_wartosc: 'cofniety')
        BD-->>BE: OK

        BE-->>FE: 200 OK<br/>{pomocnik_id, status: 'cofniety'}
        FE-->>K: Potwierdzenie:<br/>"Dostęp pomocnika został cofnięty"

        Note over P: Przy następnej próbie<br/>dostępu pomocnik otrzyma<br/>komunikat o cofnięciu uprawnień
    end
