flowchart TD
    classDef edgeCase fill:#f1f5f9,stroke:#64748b,stroke-width:2px;
    classDef detection fill:#fef3c7,stroke:#d97706,stroke-width:2px;
    classDef resolution fill:#dcfce7,stroke:#16a34a,stroke-width:2px;
    classDef rejection fill:#fee2e2,stroke:#dc2626,stroke-width:2px;

    subgraph EC1 ["1. Zmiana statusu w trakcie (np. Student -> Pracownik)"]
        EC1_Trigger[Użytkownik edytuje profil: zmiana celu pobytu lub zatrudnienia]:::detection
        EC1_Preserve[Zachowanie dotychczas oznaczonych jako 'WYKONANY' kroków]:::resolution
        EC1_Recalc[Przeliczenie grafu z nowymi regułami dostępności]:::resolution
        EC1_Diff[Do planu dodane zostają nowe procedury zawodowe; nieaktualne usunięte bez utraty historii]:::resolution
        EC1_Trigger --> EC1_Preserve --> EC1_Recalc --> EC1_Diff
    end

    subgraph EC2 ["2. Alternatywy w wymaganiach (Warunki AND vs OR dla dokumentów)"]
        EC2_Trigger[Procedura wymaga dokumentu A LUB dokumentu B]:::detection
        EC2_Eval{Użytkownik posiada A lub B?}:::detection
        EC2_Ok[Warunek spełniony: krok procedury odblokowany]:::resolution
        EC2_Wait[Warunek niespełniony: krok oznaczony jako zablokowany]:::rejection
        EC2_Trigger --> EC2_Eval
        EC2_Eval -- Posiada przynajmniej 1 --> EC2_Ok
        EC2_Eval -- Brak obu --> EC2_Wait
    end

    subgraph EC3 ["3. Krok wykonany przed użyciem systemu"]
        EC3_Trigger[Klient podczas ankiety/profilowania zaznacza: 'Posiadam już PESEL / meldunek']:::detection
        EC3_Skip[Krok oznaczany od razu jako 'WYKONANY (historycznie)']:::resolution
        EC3_Unlock[Zależne procedury kolejnego poziomu zostają natychmiast odblokowane]:::resolution
        EC3_Trigger --> EC3_Skip --> EC3_Unlock
    end

    subgraph EC4 ["4. Procedura niedostępna dla danej grupy obywatelstwa"]
        EC4_Trigger[Klient z UE przegląda procedury zezwolenia na pobyt czasowy]:::detection
        EC4_Rule[Regula dostępności: jest_dostepna = FALSE dla grupy UE]:::detection
        EC4_Filter[Procedura całkowicie odfiltrowana z generatora planu + komunikat informacyjny w wyszukiwarce]:::resolution
        EC4_Trigger --> EC4_Rule --> EC4_Filter
    end

    subgraph EC5 ["5. Wykrywanie cykli w zależnościach (Zabezpieczenie Panelu Admina)"]
        EC5_Trigger[Admin próbuje dodać zależność: Procedura C wymaga B, B wymaga A, A wymaga C]:::rejection
        EC5_DFS[Backend uruchamia algorytm wykrywania cykli Tarjana / DFS na grafie skierowanym]:::detection
        EC5_CycleFound{Czy wykryto cykl?}:::detection
        EC5_Reject[Transakcja wycofana (ROLLBACK) + błąd HTTP 422: 'Zależność tworzy cykl!']:::rejection
        EC5_Save[Zapis zależności do bazy i dziennika zmian]:::resolution
        EC5_Trigger --> EC5_DFS --> EC5_CycleFound
        EC5_CycleFound -- Tak --> EC5_Reject
        EC5_CycleFound -- Nie --> EC5_Save
    end

    subgraph EC6 ["6. Brak tłumaczenia na wybrany język (Fallback Chain)"]
        EC6_Req[Żądanie treści w języku RU lub UK]:::detection
        EC6_Check{Czy istnieje rekord w tlumaczenia?}:::detection
        EC6_ShowL1[Wyświetlenie tekstu w żądanym języku]:::resolution
        EC6_FallPL{Czy jest w PL?}:::detection
        EC6_ShowPL[Wyświetlenie tekstu w j. polskim + flaga fallback]:::resolution
        EC6_ShowEN[Wyświetlenie tekstu w j. angielskim fallback]:::resolution
        EC6_Req --> EC6_Check
        EC6_Check -- Tak --> EC6_ShowL1
        EC6_Check -- Nie --> EC6_FallPL
        EC6_FallPL -- Tak --> EC6_ShowPL
        EC6_FallPL -- Nie --> EC6_ShowEN
    end

    class EC1,EC2,EC3,EC4,EC5,EC6 fill:#ffffff,stroke:#94a3b8,stroke-width:1px;
