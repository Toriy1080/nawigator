flowchart TD
    classDef startEnd fill:#0f172a,stroke:#020617,stroke-width:2px,color:#ffffff;
    classDef guestAction fill:#f8fafc,stroke:#94a3b8,stroke-width:2px;
    classDef authAction fill:#e0f2fe,stroke:#0284c7,stroke-width:2px;
    classDef coreAction fill:#dbeafe,stroke:#2563eb,stroke-width:2px;
    classDef helperAction fill:#fef3c7,stroke:#d97706,stroke-width:2px;
    classDef decision fill:#fed7aa,stroke:#ea580c,stroke-width:2px;
    classDef success fill:#dcfce7,stroke:#16a34a,stroke-width:2px;

    Start([Wejście na stronę Nawigatora]):::startEnd --> GuestView[Przeglądanie bazy wiedzy / wyszukiwarki / słownika w wybranym języku]:::guestAction

    GuestView --> FillSurvey[Wypełnienie anonimowej ankiety wstępnej]:::guestAction
    FillSurvey --> SamplePlan[Podgląd przykładowego planu kroków]:::guestAction

    SamplePlan --> DecReg{"Czy użytkownik chce zapisać postęp i dokumenty?"}:::decision
    DecReg -- Nie --> GuestExit([Użytkownik korzysta wyłącznie informacyjnie]):::startEnd

    DecReg -- Tak --> Register[Rejestracja konta: E-mail, Hasło, Zgoda RODO, Narodowość obowiązkowa!]:::authAction
    Register --> Login[Logowanie: Utworzenie bezpiecznej sesji HttpOnly]:::authAction

    Login --> CompleteProfile[Uzupełnienie profilu: Kraj, Podstawa pobytu, Cel pobytu, Forma zatrudnienia]:::authAction
    CompleteProfile --> SelectSit[Wybór sytuacji życiowej np. 'Zaczynam pracę w Polsce']:::coreAction

    SelectSit --> GenPlan[Silnik grafu generuje spersonalizowany plan kroków z uwzględnieniem zależności]:::coreAction
    GenPlan --> CheckDocs[Oznaczenie już posiadanych dokumentów np. paszport, dyplom, wiza]:::coreAction

    CheckDocs --> RecalcInit[Automatyczne odznaczenie kroków historycznie spełnionych]:::coreAction

    subgraph Loop ["Główna pętla realizacji procedur"]
        RecalcInit --> ViewPlan[Przeglądanie planu: Kroki dostępne, w trakcie, zablokowane]:::coreAction
        ViewPlan --> ActionStep[Realizacja procedury w urzędzie / online z linków źródłowych]:::coreAction
        ActionStep --> MarkStep[Oznaczenie kroku jako 'Wykonany']:::coreAction
        MarkStep --> UnlockNext[Automatyczne odblokowanie kolejnych kroków w grafie DAG]:::coreAction

        UnlockNext --> DecHelp{"Czy potrzebna pomoc asystenta / doradcy?"}:::decision
        DecHelp -- Tak --> InviteHelper[Wygenerowanie zaproszenia dla Pomocnika]:::helperAction
        InviteHelper --> HelperActive[Pomocnik przegląda plan, dodaje notatki, potwierdza kroki]:::helperAction
        HelperActive --> DecRevoke{"Czy zakończono współpracę?"}:::decision
        DecRevoke -- Tak --> RevokeHelper[Cofnięcie uprawnień pomocnikowi przez klienta]:::authAction
        RevokeHelper --> CheckDone{"Czy wszystkie kroki planu wykonane?"}:::decision
        DecHelp -- Nie --> CheckDone

        UnlockNext --> DecChangeStatus{"Czy zaszła zmiana sytuacji życiowej?"}:::decision
        DecChangeStatus -- Tak --> EditProfile[Edycja profilu klienta]:::authAction
        EditProfile --> RecalcGraph[Przeliczenie grafu z zachowaniem wykonanych kroków]:::coreAction
        RecalcGraph --> ViewPlan
        DecChangeStatus -- Nie --> CheckDone

        CheckDone -- Nie --> ViewPlan
    end

    CheckDone -- Tak --> AllDone([🎉 Sukces: Wszystkie procedury administracyjne zakończone]):::success

    class Loop fill:#f8fafc,stroke:#cbd5e1,stroke-width:1px;
