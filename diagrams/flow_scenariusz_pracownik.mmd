%% Activity/Flow Diagram: Scenariusz - Pracownik spoza UE
%% Nawigator procedur administracyjnych

flowchart TD
    START(["▶ Scenariusz: Pracownik spoza UE"])

    START --> A["📋 1. Oświadczenie pracodawcy\no powierzeniu pracy /\nZezwolenie na pracę\n(pracodawca rejestruje w PUP\nlub składa wniosek do wojewody)"]

    A --> B["🛂 2. Wiza pracownicza\n(wniosek w konsulacie RP\nw kraju pochodzenia)"]

    B --> C["✈️ 3. Przyjazd do Polski\n(wjazd na podstawie wizy)"]

    C --> D["🏠 4. Zameldowanie\n(rejestracja adresu pobytu\nw urzędzie gminy\nw ciągu 4 dni)"]

    C --> E["📄 7. ZUS\n(zgłoszenie do ubezpieczeń\nspołecznych przez pracodawcę\nw ciągu 7 dni od zatrudnienia)"]

    D --> F["🆔 5. PESEL\n(nadanie numeru PESEL\nprzy zameldowaniu\nlub osobny wniosek)"]

    D --> G["🪪 6. Karta pobytu czasowego\n(wniosek do wojewody,\ncel: praca,\njeśli pobyt > 3 mies.)"]

    E --> H["🏥 8. NFZ\n(ubezpieczenie zdrowotne\nzgłoszenie przez ZUS\npo rejestracji w ZUS)"]

    F --> I["Kontynuacja..."]
    G --> I
    H --> I

    I --> ENDX(["⏹ Plan pracownika ukończony"])

    %% Dependency and parallelism annotations
    subgraph phase1 ["🔗 Faza 1: Przed przyjazdem (sekwencyjne)"]
        A
        B
    end

    subgraph phase2 ["🔗 Faza 2: Przyjazd"]
        C
    end

    subgraph parallel_after_arrival ["⚡ Faza 3: Po przyjeździe (częściowo równoległe)"]
        direction TB
        subgraph track_meldunek ["Ścieżka: Zameldowanie"]
            D
            F
            G
        end
        subgraph track_praca ["Ścieżka: Zatrudnienie"]
            E
            H
        end
    end

    style START fill:#4CAF50,color:#fff
    style ENDX fill:#9E9E9E,color:#fff
    style A fill:#1565C0,color:#fff
    style B fill:#1565C0,color:#fff
    style C fill:#2E7D32,color:#fff
    style D fill:#00838F,color:#fff
    style E fill:#6A1B9A,color:#fff
    style F fill:#AD1457,color:#fff
    style G fill:#E65100,color:#fff
    style H fill:#6A1B9A,color:#fff
    style I fill:#43A047,color:#fff

    style phase1 fill:#E3F2FD,stroke:#1565C0,stroke-width:2px
    style phase2 fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px
    style parallel_after_arrival fill:#FFF3E0,stroke:#E65100,stroke-width:2px
    style track_meldunek fill:#E0F7FA,stroke:#00838F,stroke-width:2px
    style track_praca fill:#F3E5F5,stroke:#6A1B9A,stroke-width:2px
