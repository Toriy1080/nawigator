%% State Diagram: Cykl życia konta użytkownika
%% Nawigator procedur administracyjnych

stateDiagram-v2
    direction TB

    [*] --> rejestracja : Użytkownik wypełnia\nformularz rejestracji

    rejestracja : 📝 Rejestracja
    rejestracja : ─────────────────────
    rejestracja : Konto utworzone, ale nieaktywne.
    rejestracja : Oczekiwanie na potwierdzenie:
    rejestracja : • weryfikacja adresu email
    rejestracja : • potwierdzenie narodowości
    rejestracja : created_at = NOW()

    aktywne : ✅ Aktywne
    aktywne : ─────────────────────
    aktywne : Konto w pełni aktywne.
    aktywne : Użytkownik ma dostęp do
    aktywne : wszystkich funkcji systemu.
    aktywne : email_verified = TRUE
    aktywne : nationality_confirmed = TRUE

    zablokowane : 🚫 Zablokowane
    zablokowane : ─────────────────────
    zablokowane : Konto tymczasowo zablokowane
    zablokowane : przez administratora.
    zablokowane : Użytkownik nie może się zalogować.
    zablokowane : blocked_at = NOW()
    zablokowane : blocked_reason = '...'

    usuniete : 🗑️ Usunięte
    usuniete : ─────────────────────
    usuniete : Konto oznaczone do usunięcia.
    usuniete : Dane osobowe usunięte (GDPR).
    usuniete : deleted_at = NOW()

    rejestracja --> aktywne : Email zweryfikowany\nORAZ narodowość potwierdzona
    aktywne --> zablokowane : Administrator blokuje konto\n(np. naruszenie regulaminu)
    zablokowane --> aktywne : Administrator odblokowuje konto
    aktywne --> usuniete : Użytkownik żąda usunięcia konta\n(prawo do bycia zapomnianym - GDPR)

    usuniete --> [*] : Wszystkie dane osobowe usunięte\n(anonimizacja rekordów)

    note right of rejestracja
        Warunki aktywacji:
        1. Klik na link weryfikacyjny w emailu
        2. Potwierdzenie narodowości
           (wybór z listy / oświadczenie)
        Timeout: konto nieaktywowane
        po X dniach → automatyczne usunięcie
    end note

    note right of zablokowane
        Powody blokady:
        • Podejrzenie nadużycia
        • Naruszenie regulaminu
        • Żądanie organów
        Admin musi podać powód blokady.
    end note

    note left of usuniete
        Proces usuwania (GDPR):
        1. Użytkownik potwierdza żądanie
        2. Dane osobowe anonimizowane
        3. Logi aktywności usunięte
        4. Plany i postępy usunięte
        5. Zachowane: statystyki anonimowe
    end note
